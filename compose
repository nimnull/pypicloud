#!/bin/bash
set -e

CURRENT_UID=$(id -u):$(id -g)
export CURRENT_UID

if [ -z "$1" ]; then
  echo "$0 [test,shell,run,*]"
elif [ "$1" == "test" ]; then
  docker compose --env-file /dev/null run --rm shell uv run --frozen pytest
elif [ "$1" == "run" ]; then
  shift
  docker compose --env-file /dev/null run --rm shell "$@"
elif [ "$1" == "shell" ]; then
  docker compose --env-file /dev/null up --build --remove-orphans -d shell
  docker attach pypicloud-shell-1
else
  docker compose --env-file /dev/null "$@"
fi
